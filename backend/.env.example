# Server Configuration
PORT=5001
NODE_ENV=production

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-example-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Super Admin Credentials
ADMIN_EMAIL=admin@srimahalakshmi.com
